# Copy to .env and fill in. docker-compose.yml passes each of these to the container
# (UID/GID are used when building the image). Keep the single quotes: password hashes contain "$".
# At least 32 characters. Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=''
FROOGLEDRIVE_USERNAME='admin'
# Generate with: docker compose run --rm froogledrive python -m app.hash_password
FROOGLEDRIVE_PASSWORD_HASH=''
# Optional: shown in parentheses after "FroogleDrive" in the header
# (use double quotes if the text contains an apostrophe)
# FROOGLEDRIVE_SUBTITLE="(My Cloudshare System)"

# Optional: public origin used when building share links (e.g. behind a reverse proxy)
# PUBLIC_BASE_URL='https://files.example.com'
# Optional: set to 1 when running behind exactly one reverse proxy (trusts X-Forwarded-*)
# FROOGLEDRIVE_TRUST_PROXY=1
# Optional: set to 1 when served over HTTPS
# FROOGLEDRIVE_SECURE_COOKIES=1

# Optional: container user/group IDs; match the owner of the mounted files (`id -u`, `id -g`)
# UID=1000
# GID=1000
